{
  "name": "itchy",
  "version": "0.2.0",
  "description": "A music-making toy for children aged 6–11, in the browser, built on the openDAW engine.",
  "keywords": [
    "music",
    "children",
    "education",
    "sequencer",
    "opendaw",
    "toy"
  ],
  "bugs": "https://github.com/hcaw/itchy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcaw/itchy.git"
  },
  "author": "Harry Wright",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@opendaw/studio-sdk": "0.0.182",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  }
}
