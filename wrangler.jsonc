{
  // Cloudflare Workers, serving the built app as static assets (no Worker script). Workers Builds runs
  // `npm run build`, then `npx wrangler deploy`. public/_headers (copied to dist/) adds the isolation headers.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itchy",
  "compatibility_date": "2026-11-08",
  // Set explicitly rather than left to Cloudflare's defaults: workers.dev is Itchy's only address, and each version
  // gets its own preview URL so a change can be tried on a real tablet before it's merged.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
