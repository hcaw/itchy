{
  // Cloudflare Workers, serving the built app as static assets (no Worker script). Workers Builds runs
  // `npm run build`, then `npx wrangler deploy`. public/_headers (copied to dist/) adds the isolation headers.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itchy",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
